# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Brevo (Transactional Email)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=sender@yourdomain.com
BREVO_SENDER_NAME=Your Service Name

# OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_RATE_WINDOW_SECONDS=900
OTP_RATE_MAX_REQUESTS=3
LOCAL_OTP_MODE=true

# Captcha Settings
CAPTCHA_EXPIRY_SECONDS=300
CAPTCHA_SALT_ROUNDS=8
CAPTCHA_RATE_WINDOW_MS=60000
CAPTCHA_RATE_MAX_REQUESTS=10

# Server
PORT=5000
# Server
PORT=5000
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security / Rate limiting
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=5
