# AI Provider Configuration (Gemma 4A 26B)
AI_PROVIDER=openrouter
AI_MODEL=gemma4a:26b
AI_BASE_URL=https://openrouter.io/api/v1
OPENROUTER_API_KEY=sk_your_api_key_here
AI_TIMEOUT=30000
AI_MAX_RETRIES=3

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/aura-study

# Authentication Secrets
JWT_SECRET=your-jwt-secret-here
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Admin Configuration (dynamic via .env)
ADMIN_EMAIL=admin@aura.ai
ADMIN_PASSWORD_HASH=$2b$12$hashed_password_here

# Redis/Upstash Configuration (for rate limiting)
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=your_redis_token_here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support & Community Contact
NEXT_PUBLIC_SUPPORT_PHONE=7379307099
NEXT_PUBLIC_SUPPORT_PHONE2=9532415871
NEXT_PUBLIC_SUPPORT_EMAIL=helpsupport9452@gmail.com

# Admin Initialization (only used once, then disable)
ADMIN_INIT_SECRET=your-super-secret-admin-init-token
